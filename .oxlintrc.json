{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "import", "node"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"env": {
		"builtin": true,
		"node": true
	},
	"rules": {
		"typescript/no-explicit-any": "error",
		"unicorn/prefer-node-protocol": "error",
		"eqeqeq": "error",
		"no-var": "error",
		"prefer-const": "error"
	},
	"ignorePatterns": ["node_modules/**", "dist/**", ".agents/**", "skills-lock.json"]
}
