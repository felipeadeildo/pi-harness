{
	"name": "@adeildo/pi-harness",
	"version": "0.0.0",
	"description": "Felipe Adeildo's Pi harness: a start screen, framed editor and footer in your theme's colours, and Anthropic OAuth billed to the Claude plan. Each feature is its own extension, so pi config turns one off.",
	"keywords": [
		"anthropic",
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"pi-package",
		"statusline",
		"subscription",
		"theme"
	],
	"license": "MIT",
	"author": {
		"name": "Felipe Adeildo",
		"email": "contato@felipeadeildo.com",
		"url": "https://github.com/felipeadeildo"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/felipeadeildo/pi-harness.git",
		"directory": "packages/harness"
	},
	"files": [
		"src",
		"docs",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"exports": {
		"./look": "./src/look/index.ts",
		"./providers": "./src/providers/index.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@adeildo/pi-kit": "workspace:*"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"pi": {
		"extensions": [
			"./src/look/index.ts",
			"./src/providers/index.ts"
		]
	}
}
