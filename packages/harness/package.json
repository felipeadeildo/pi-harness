{
	"name": "@adeildo/pi-harness",
	"version": "4.1.0",
	"description": "Every adeildo Pi extension in one install: the permission dialog, the look and the providers. Each is its own extension, so pi config turns one off.",
	"keywords": [
		"anthropic",
		"permission",
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"pi-package",
		"statusline",
		"theme"
	],
	"homepage": "https://github.com/felipeadeildo/pi-harness/tree/main/packages/harness#readme",
	"bugs": "https://github.com/felipeadeildo/pi-harness/issues",
	"license": "MIT",
	"author": {
		"name": "adeildo",
		"email": "contato@felipeadeildo.com",
		"url": "https://github.com/felipeadeildo"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/felipeadeildo/pi-harness.git",
		"directory": "packages/harness"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@adeildo/pi-ask-permission": "workspace:*",
		"@adeildo/pi-kit": "workspace:*",
		"@adeildo/pi-look": "workspace:*",
		"@adeildo/pi-providers": "workspace:*"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"pi": {
		"extensions": [
			"./src/permission.ts",
			"./src/look.ts",
			"./src/providers.ts"
		]
	}
}
