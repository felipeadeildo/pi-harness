		"pi",
		"pi-coding-agent",
		"pi-extension",
		"pi-package",
		"session-memory"
	],
	"homepage": "https://github.com/felipeadeildo/pi-harness/tree/main/packages/board#readme",
	"bugs": "https://github.com/felipeadeildo/pi-harness/issues",
	"license": "MIT",
	"author": {
		"name": "adeildo",
		"email": "contato@felipeadeildo.com",
		"url": "https://github.com/felipeadeildo"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/felipeadeildo/pi-harness.git",
		"directory": "packages/board"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
