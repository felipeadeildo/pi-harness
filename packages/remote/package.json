{
	"name": "@adeildo/pi-remote",
	"version": "6.0.0",
	"description": "Your pi sessions on every machine of yours, from a phone or a browser at one address on your tailnet: a bridge in every pi, a daemon per machine, and the pi-remote command.",
	"license": "MIT",
	"author": {
		"name": "adeildo",
		"email": "contato@felipeadeildo.com",
		"url": "https://github.com/felipeadeildo"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/felipeadeildo/pi-harness.git",
		"directory": "packages/remote"
	},
	"files": [
		"src",
		"dist",
		"README.md"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "bun build.ts",
		"dev": "cd web && bun x vite",
		"prepack": "bun build.ts",
		"gate": "bun run test/e2e/flow.ts"
	},
	"dependencies": {
		"@adeildo/pi-kit": "workspace:*",
		"@adeildo/pi-remote-protocol": "workspace:*"
	},
	"devDependencies": {
		"@adeildo/pi-ask-permission": "workspace:*",
		"@adeildo/pi-ask-questions": "workspace:*",
		"@base-ui/react": "^1.9.0",
		"@fontsource-variable/mona-sans": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.3.5",
		"@hugeicons/react": "^1.1.10",
		"@pierre/diffs": "^1.6.1",
		"@shadcn/react": "^0.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.0",
		"mermaid": "^12.2.0",
		"playwright-core": "1.64.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-markdown": "^10.1.0",
		"react-router": "^8.5.0",
		"remark-gfm": "^4.0.1",
		"shiki": "^4.5.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"vite": "^8.3.5"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
