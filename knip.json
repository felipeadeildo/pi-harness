{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		"packages/*": {
			"entry": ["test/**/*.test.ts"]
		},
		"packages/kit": {
			"entry": ["test/**/*.test.ts", "test/*worker.ts"]
		},
		"packages/look": {
			"entry": ["test/**/*.test.ts", "test/helpers.ts"]
		},
		"packages/providers": {
			"entry": ["test/**/*.test.ts", "test/helpers.ts", "eval/**/*.ts"]
		},
		"packages/compact": {
			"entry": ["test/**/*.test.ts", "eval/**/*.ts"]
		},
		"packages/peers": {
			"entry": ["test/**/*.test.ts", "eval/**/*.ts"]
		},
		"packages/harness": {
			"entry": ["src/*.ts", "test/**/*.test.ts"]
		},
		"packages/remote": {
			"entry": [
				"src/cli/main.ts",
				"src/daemon/main.ts",
				"test/**/*.test.ts",
				"test/**/*.ts",
				"web/src/main.tsx",
				"web/vite.config.ts",
				"web/src/**/*.test.ts",
				"scripts/*.ts"
			],
			"ignore": ["web/src/components/ui/**", "web/src/lib/**"]
		},
		".": {
			"entry": ["scripts/**/*.ts"]
		}
	},
	"ignoreBinaries": ["script", "rsvg-convert", "tailscale"]
}
