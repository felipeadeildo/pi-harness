{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"types": ["react", "react-native"],
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
